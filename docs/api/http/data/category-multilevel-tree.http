@host = http://localhost:8080
@nextjsServerClientId = uniapi-nextjs-server

### Get category read access token
# Requires categories:read or SCOPE_categories:read.
# @name categoryReadToken
# @prompt nextjsServerClientSecret Next.js server client secret
POST {{host}}/oauth2/token
Authorization: Basic {{nextjsServerClientId}} {{nextjsServerClientSecret}}
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials&scope=api categories:read

### Get category write access token
# Requires categories:write or SCOPE_categories:write.
# @name categoryWriteToken
# @prompt nextjsServerClientSecret Next.js server client secret
POST {{host}}/oauth2/token
Authorization: Basic {{nextjsServerClientId}} {{nextjsServerClientSecret}}
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials&scope=api categories:write

### Create level 0 root category
# @name rootCategory
POST {{host}}/api/v1/categories
Content-Type: application/json
Authorization: Bearer {{categoryWriteToken.response.body.$.access_token}}

{
  "slug": "knowledge-base",
  "name": "Knowledge Base",
  "description": "Root category for a multi-level category tree",
  "active": true
}

### Create level 1 child A
# @name operationsCategory
POST {{host}}/api/v1/categories
Content-Type: application/json
Authorization: Bearer {{categoryWriteToken.response.body.$.access_token}}

{
  "parentId": {{rootCategory.response.body.$.id}},
  "slug": "operations",
  "name": "Operations",
  "description": "Operational knowledge",
  "active": true
}

### Create level 1 child B
# @name financeCategory
POST {{host}}/api/v1/categories
Content-Type: application/json
Authorization: Bearer {{categoryWriteToken.response.body.$.access_token}}

{
  "parentId": {{rootCategory.response.body.$.id}},
  "slug": "finance",
  "name": "Finance",
  "description": "Financial knowledge",
  "active": true
}

