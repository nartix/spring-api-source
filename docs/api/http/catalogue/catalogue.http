### Get catalogue read access token
# Requires catalogue:read or SCOPE_catalogue:read.
# @name catalogueReadToken
# @prompt nextjsServerClientSecret Next.js server client secret
POST http://localhost:8080/oauth2/token
Authorization: Basic uniapi-nextjs-server {{nextjsServerClientSecret}}
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials&scope=api catalogue:read

### Get catalogue write access token
# Requires catalogue:write or SCOPE_catalogue:write.
# @name catalogueWriteToken
# @prompt nextjsServerClientSecret Next.js server client secret
POST http://localhost:8080/oauth2/token
Authorization: Basic uniapi-nextjs-server {{nextjsServerClientSecret}}
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials&scope=api catalogue:write

### List products
GET http://localhost:8080/api/v1/products?page=0&size=24&sort=title,asc
Authorization: Bearer {{catalogueReadToken.response.body.$.access_token}}

### List products with multiple sorts and marketplace default
GET http://localhost:8080/api/v1/products?page=0&size=24&marketplace=CA&sort=currentPrice,asc&sort=title,asc
Authorization: Bearer {{catalogueReadToken.response.body.$.access_token}}

### List products for a merchant store
GET http://localhost:8080/api/v1/products?merchantStore=amazon-ca&hasCurrentPrice=true&sort=currentPrice,asc
Authorization: Bearer {{catalogueReadToken.response.body.$.access_token}}

### List storage products
GET http://localhost:8080/api/v1/storage-products?capacityGbMin=1000&sort=capacityGb,desc
Authorization: Bearer {{catalogueReadToken.response.body.$.access_token}}

### List CPUs
GET http://localhost:8080/api/v1/cpus?coreCountMin=8&sort=boostClockGhz,desc
Authorization: Bearer {{catalogueReadToken.response.body.$.access_token}}

### List graphics cards
GET http://localhost:8080/api/v1/graphics-cards?vramGbMin=12&sort=currentPrice,asc
Authorization: Bearer {{catalogueReadToken.response.body.$.access_token}}

### List category products
GET http://localhost:8080/api/v1/categories/storage/products?page=0&size=24&sort=title,asc
Authorization: Bearer {{catalogueReadToken.response.body.$.access_token}}

### Public catalogue category ranking capabilities
GET http://localhost:8080/api/v1/catalogue/categories/capabilities
Authorization: Bearer {{catalogueReadToken.response.body.$.access_token}}

### Public catalogue category sort contract note
# The public catalogue surface does not expose a category sibling/tree list endpoint with category
# sort parameters. /api/v1/categories/{slug}/products sorts products, not category siblings, so
# category sortRank ordering is exposed through admin scoped lists and category write responses.

### Get product detail
GET http://localhost:8080/api/v1/products/1
Authorization: Bearer {{catalogueReadToken.response.body.$.access_token}}

### Get product detail by canonical slug
GET http://localhost:8080/api/v1/products/1/sample-product
Authorization: Bearer {{catalogueReadToken.response.body.$.access_token}}

### Invalid listing size
GET http://localhost:8080/api/v1/products?size=101
Authorization: Bearer {{catalogueReadToken.response.body.$.access_token}}

### Invalid listing sort
GET http://localhost:8080/api/v1/products?sort=passwordHash,asc
Authorization: Bearer {{catalogueReadToken.response.body.$.access_token}}

### Invalid product listing sortRank
# Expected: 400, message key catalogue.api.list.sort.allowed; this is a product list, not a category sibling list.
GET http://localhost:8080/api/v1/categories/storage/products?sort=sortRank,desc
Authorization: Bearer {{catalogueReadToken.response.body.$.access_token}}

### Invalid family-specific filter
GET http://localhost:8080/api/v1/storage-products?coreCountMin=8
Authorization: Bearer {{catalogueReadToken.response.body.$.access_token}}

### List brands
GET http://localhost:8080/api/v1/catalogue/brands?page=0&size=20&sort=name,asc
Authorization: Bearer {{catalogueReadToken.response.body.$.access_token}}

### Get brand
# @prompt catalogueBrandLookupId Existing catalogue brand id
GET http://localhost:8080/api/v1/catalogue/brands/{{catalogueBrandLookupId}}
Authorization: Bearer {{catalogueReadToken.response.body.$.access_token}}

### Create brand
# @name createBrand
POST http://localhost:8080/api/v1/catalogue/brands
Authorization: Bearer {{catalogueWriteToken.response.body.$.access_token}}
Content-Type: application/json

{
  "name": "Local Test Brand",
  "slug": "local-test-brand",
  "active": true
}

### Replace brand
PUT http://localhost:8080/api/v1/catalogue/brands/{{createBrand.response.body.$.id}}
Authorization: Bearer {{catalogueWriteToken.response.body.$.access_token}}
Content-Type: application/json

{
  "name": "Local Test Brand Updated",
  "slug": "local-test-brand",
  "active": true
}

### Patch brand
PATCH http://localhost:8080/api/v1/catalogue/brands/{{createBrand.response.body.$.id}}
Authorization: Bearer {{catalogueWriteToken.response.body.$.access_token}}
Content-Type: application/merge-patch+json

{
  "name": "Local Test Brand Patched"
}

### Delete brand
DELETE http://localhost:8080/api/v1/catalogue/brands/{{createBrand.response.body.$.id}}
Authorization: Bearer {{catalogueWriteToken.response.body.$.access_token}}

