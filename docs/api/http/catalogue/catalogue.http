Authorization: Bearer {{catalogueWriteToken.response.body.$.access_token}}
Content-Type: application/json

{
  "title": "Local Test Storage Drive",
  "slug": "local-test-storage-drive",
  "family": "STORAGE",
  "brandId": {{catalogueBrandId}},
  "manufacturerId": {{catalogueManufacturerId}},
  "mainImageUrl": "https://example.test/local-test-storage-drive.png",
  "shortDescription": "Safe local catalogue write example",
  "identifiers": [
    {
      "family": "UPC",
      "value": "036000291452",
      "primary": true
    }
  ],
  "active": true
}

