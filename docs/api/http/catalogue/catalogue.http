Authorization: Bearer {{catalogueWriteToken.response.body.$.access_token}}
Content-Type: application/merge-patch+json

{
  "name": "Local Test Category Patched",
  "parentId": null
}

### Move category to parent
# @prompt catalogueParentCategoryId Existing parent category id
POST http://localhost:8080/api/v1/catalogue/categories/{{createCategory.response.body.$.id}}/move
Authorization: Bearer {{catalogueWriteToken.response.body.$.access_token}}
Content-Type: application/json

{
  "newParentId": {{catalogueParentCategoryId}},
  "targetIndex": 0
}

### Move category to root
POST http://localhost:8080/api/v1/catalogue/categories/{{createCategory.response.body.$.id}}/move
Authorization: Bearer {{catalogueWriteToken.response.body.$.access_token}}
Content-Type: application/json

{
  "newParentId": null
}

### Reorder category within current sibling group
# @prompt afterCatalogueCategoryId Existing sibling id
POST http://localhost:8080/api/v1/catalogue/categories/{{createCategory.response.body.$.id}}/reorder
Authorization: Bearer {{catalogueWriteToken.response.body.$.access_token}}
Content-Type: application/json

{
  "afterId": {{afterCatalogueCategoryId}}
}

### Reject invalid public category placement
# Expected: 400, message key catalogue.api.category.placement.conflict.
# @prompt beforeCatalogueCategoryId Existing sibling id
# @prompt afterCatalogueCategoryId Existing sibling id
POST http://localhost:8080/api/v1/catalogue/categories/{{createCategory.response.body.$.id}}/reorder
Authorization: Bearer {{catalogueWriteToken.response.body.$.access_token}}
Content-Type: application/json

{
  "beforeId": {{beforeCatalogueCategoryId}},
  "afterId": {{afterCatalogueCategoryId}}
}

### Activate category
POST http://localhost:8080/api/v1/catalogue/categories/{{createCategory.response.body.$.id}}/activate
Authorization: Bearer {{catalogueWriteToken.response.body.$.access_token}}

### Deactivate category
POST http://localhost:8080/api/v1/catalogue/categories/{{createCategory.response.body.$.id}}/deactivate
Authorization: Bearer {{catalogueWriteToken.response.body.$.access_token}}

### Delete category
DELETE http://localhost:8080/api/v1/catalogue/categories/{{createCategory.response.body.$.id}}
Authorization: Bearer {{catalogueWriteToken.response.body.$.access_token}}

### Disabled-ranking contract note
# Do not run this against production catalogue categories; production catalogue categories are ranked.
# Disabled ranking is covered by the unranked fixture/service tests. A disabled system rejects
# beforeId, afterId, and targetIndex with HTTP 400 and message keys:
# catalogue.api.category.ranking.disabled.before-id,
# catalogue.api.category.ranking.disabled.after-id,
# catalogue.api.category.ranking.disabled.target-index.
# Clients must use GET /api/v1/catalogue/categories/capabilities as the ranking discovery signal,
# not ordinary category response fields or failed write attempts.
