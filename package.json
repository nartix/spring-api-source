{
  "name": "spring-api-source-tooling",
  "private": true,
  "description": "Source formatting for the Spring API.",
  "scripts": {
    "format": "prettier --write \"**/*.{java,json,yml,yaml,html,css,js,mjs,cjs}\"",
    "format:check": "prettier --check \"**/*.{java,json,yml,yaml,html,css,js,mjs,cjs}\""
  },
  "devDependencies": {
    "prettier": "3.8.3",
    "prettier-plugin-java": "2.9.7"
  }
}
