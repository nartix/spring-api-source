# Example shell variables for a disposable local development database.
# Export these variables in your shell; Spring does not load .env automatically.
SPRING_PROFILES_ACTIVE=dev
APP_POSTGRES_HOST=localhost
APP_POSTGRES_PORT=5432
APP_POSTGRES_DATABASE=app
APP_POSTGRES_USERNAME=app
APP_POSTGRES_PASSWORD=app
# Explicitly opt in to initial local administrator creation when needed.
APP_BOOTSTRAP_ADMIN_ENABLED=false
APP_BOOTSTRAP_ADMIN_USERNAME=
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=
